<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>selfgrow — Self-Growing Functional Language</title>
  <style>
    :root {
      --bg: #0d1117;
      --bg-elevated: #161b22;
      --fg: #e6edf3;
      --fg-muted: #8b949e;
      --accent: #58a6ff;
      --accent-hover: #79c0ff;
      --border: #30363d;
      --editor-bg: #0d1117;
      --output-bg: #0d1117;
      --error: #f85149;
      --success: #3fb950;
      --focus: #58a6ff;
      --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
      --font-ui: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --spacing: 1rem;
      --radius: 6px;
      --transition: 150ms ease;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
    }

    body {
      font-family: var(--font-ui);
      background: var(--bg);
      color: var(--fg);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    a:focus-visible,
    button:focus-visible,
    textarea:focus-visible,
    [tabindex]:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    /* Header */
    header {
      padding: var(--spacing) calc(var(--spacing) * 2);
      border-bottom: 1px solid var(--border);
      background: var(--bg-elevated);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .header-content {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing);
    }

    .logo {
      font-family: var(--font-mono);
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--fg);
      letter-spacing: -0.02em;
    }

    .logo span {
      color: var(--accent);
    }

    /* Main layout */
    main {
      max-width: 1400px;
      margin: 0 auto;
      padding: var(--spacing) calc(var(--spacing) * 2);
      min-height: calc(100vh - 200px);
    }

    /* Playground */
    .playground {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing);
      margin-bottom: calc(var(--spacing) * 3);
    }

    @media (max-width: 900px) {
      .playground {
        grid-template-columns: 1fr;
      }
    }

    .pane {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      display: flex;
      flex-direction: column;
      min-height: 400px;
    }

    .pane-header {
      padding: calc(var(--spacing) * 0.75) var(--spacing);
      border-bottom: 1px solid var(--border);
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--fg-muted);
      background: rgba(255,255,255,0.02);
    }

    .pane-content {
      flex: 1;
      padding: var(--spacing);
      overflow: auto;
    }

    /* Editor */
    #editor {
      width: 100%;
      height: 100%;
      min-height: 360px;
      background: var(--editor-bg);
      color: var(--fg);
      border: none;
      resize: none;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      line-height: 1.7;
      tab-size: 2;
      padding: 0;
    }

    #editor::placeholder {
      color: var(--fg-muted);
      opacity: 0.6;
    }

    #editor:focus {
      outline: none;
    }

    /* Output */
    #output {
      background: var(--output-bg);
      color: var(--fg);
      font-family: var(--font-mono);
      font-size: 0.9rem;
      line-height: 1.7;
      white-space: pre-wrap;
      word-break: break-word;
      min-height: 360px;
    }

    #output:empty::before {
      content: "Output will appear here…";
      color: var(--fg-muted);
      opacity: 0.5;
    }

    .output-error {
      color: var(--error);
    }

    .output-value {
      color: var(--success);
    }

    /* Controls */
    .controls {
      display: flex;
      gap: calc(var(--spacing) * 0.5);
      padding: calc(var(--spacing) * 0.75) var(--spacing);
      border-top: 1px solid var(--border);
      background: rgba(255,255,255,0.02);
    }

    button {
      font-family: var(--font-ui);
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.5rem 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
      color: var(--fg);
      cursor: pointer;
      transition: background var(--transition), border-color var(--transition), color var(--transition);
    }

    button:hover {
      background: var(--bg-elevated);
      border-color: var(--accent);
    }

    button:active {
      background: var(--border);
    }

    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    button.primary {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
    }

    button.primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }

    /* Reference section */
    .reference {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .reference-header {
      padding: var(--spacing);
      border-bottom: 1px solid var(--border);
      font-size: 1rem;
      font-weight: 600;
      background: rgba(255,255,255,0.02);
    }

    .reference-content {
      padding: var(--spacing);
    }

    .capability-list {
      display: grid;
      gap: calc(var(--spacing) * 0.75);
    }

    .capability-item {
      padding: var(--spacing);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      transition: border-color var(--transition);
    }

    .capability-item:hover {
      border-color: var(--accent);
    }

    .capability-name {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 0.25rem;
    }

    .capability-summary {
      font-size: 0.875rem;
      color: var(--fg-muted);
      margin-bottom: 0.5rem;
    }

    .capability-examples {
      display: grid;
      gap: 0.25rem;
    }

    .example {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.5rem 0.75rem;
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .example-source {
      color: var(--fg);
      flex: 1;
      min-width: 200px;
    }

    .example-result {
      color: var(--success);
      white-space: nowrap;
    }

    .example-arrow {
      color: var(--fg-muted);
    }

    /* Footer */
    footer {
      padding: calc(var(--spacing) * 2);
      text-align: center;
      color: var(--fg-muted);
      font-size: 0.875rem;
      border-top: 1px solid var(--border);
      margin-top: calc(var(--spacing) * 3);
    }

    /* Visually hidden for screen readers */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Skip link */
    .skip-link {
      position: absolute;
      top: -100%;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: var(--bg);
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius);
      font-weight: 600;
      z-index: 100;
      transition: top var(--transition);
    }

    .skip-link:focus {
      top: var(--spacing);
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      * {
        transition: none !important;
        animation: none !important;
      }
    }

    /* High contrast mode support */
    @media (prefers-contrast: high) {
      :root {
        --border: #8b949e;
        --fg-muted: #c9d1d9;
      }
    }
  </style>
</head>
<body>
  <a href="#editor" class="skip-link">Skip to editor</a>

  <header>
    <div class="header-content">
      <h1 class="logo">self<span>grow</span></h1>
      <nav aria-label="Primary">
        <a href="#playground" style="margin-right: var(--spacing);">Playground</a>
        <a href="#reference">Reference</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="playground" class="playground" aria-labelledby="playground-heading">
      <h2 id="playground-heading" class="sr-only">Playground</h2>

      <div class="pane">
        <div class="pane-header">Editor</div>
        <div class="pane-content">
          <textarea
            id="editor"
            tabindex="0"
            spellcheck="false"
            aria-label="Code editor — write selfgrow programs here"
            placeholder="// Try: 1 + 2&#10;// Or define a function:&#10;// let add = (a, b) => a + b&#10;// add(3, 4)"
          ></textarea>
        </div>
        <div class="controls">
          <button id="runBtn" class="primary" type="button" aria-keyshortcuts="Enter">Run (Enter)</button>
          <button id="clearBtn" type="button" aria-keyshortcuts="Escape">Clear (Escape)</button>
          <span class="sr-only" aria-live="polite" id="runStatus"></span>
        </div>
      </div>

      <div class="pane">
        <div class="pane-header">Output</div>
        <div class="pane-content">
          <pre id="output" aria-live="polite" aria-atomic="true" tabindex="0" role="region" aria-label="Program output"></pre>
        </div>
      </div>
    </section>

    <section id="reference" class="reference" aria-labelledby="reference-heading">
      <h2 id="reference-heading" class="reference-header">Language Reference</h2>
      <div class="reference-content">
        <div class="capability-list" id="capabilityList" role="list" aria-label="Language capabilities">
          <!-- Capabilities rendered by JS below -->
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p>selfgrow — a self-growing functional language. Examples are tests. No build step.</p>
  </footer>

  <script type="module">
    import { run, capabilityMeta } from './lang/run.js';

    const editor = document.getElementById('editor');
    const output = document.getElementById('output');
    const runBtn = document.getElementById('runBtn');
    const clearBtn = document.getElementById('clearBtn');
    const runStatus = document.getElementById('runStatus');
    const capabilityList = document.getElementById('capabilityList');

    function announce(message) {
      runStatus.textContent = message;
    }

    function setOutput(text, isError = false) {
      output.textContent = text;
      output.className = isError ? 'output-error' : 'output-value';
    }

    function clear() {
      editor.value = '';
      output.textContent = '';
      output.className = '';
      editor.focus();
      announce('Cleared');
    }

    function handleRun() {
      const source = editor.value.trim();
      if (!source) {
        announce('Empty program');
        setOutput('', false);
        return;
      }
      runBtn.disabled = true;
      try {
        const result = run(source);
        const resultText = result === undefined ? '' : String(result);
        setOutput(resultText, false);
        announce(resultText || '(no output)');
      } catch (err) {
        const message = err.message || String(err);
        setOutput(`Error: ${message}`, true);
        announce(`Error: ${message}`);
      } finally {
        runBtn.disabled = false;
      }
    }

    // --- Dynamically render capability reference from module metadata ---

    function renderCapabilities() {
      capabilityList.innerHTML = capabilityMeta
        .map((cap) => {
          const examplesHtml = cap.examples
            .map((ex) => {
              return `<div class="example">
                <code class="example-source">${escapeHtml(ex.source)}</code>
                <span class="example-arrow" aria-hidden="true">→</span>
                <span class="example-result">${escapeHtml(String(ex.result))}</span>
              </div>`;
            })
            .join('');
          return `<div class="capability-item" role="listitem">
            <div class="capability-name">${escapeHtml(cap.name)}</div>
            <div class="capability-summary">${escapeHtml(cap.summary)}</div>
            ${examplesHtml ? `<div class="capability-examples">${examplesHtml}</div>` : ''}
          </div>`;
        })
        .join('');
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    renderCapabilities();

    clearBtn.addEventListener('click', clear);
    runBtn.addEventListener('click', handleRun);

    // Keyboard shortcuts
    editor.addEventListener('keydown', (e) => {
      // Tab for indentation
      if (e.key === 'Tab') {
        e.preventDefault();
        const start = editor.selectionStart;
        const end = editor.selectionEnd;
        editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
        editor.selectionStart = editor.selectionEnd = start + 2;
        return;
      }
      // Enter to run, Shift+Enter for newline
      if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        handleRun();
        return;
      }
      // Escape to clear output
      if (e.key === 'Escape') {
        e.preventDefault();
        clear();
        return;
      }
    });
  </script>
</body>
</html>